{
  "schemaVersion": 1,
  "id": "${id}",
  "version": "${version}",
  "name": "${name}",
  "description": "${description}",
  "authors": [
    "${authors}"
  ],
  "contact": {
    "sources": "${sources}",
    "issues": "${issues}"
  },
  "license": "${license}",
  "icon": "assets/c0de_paint/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "de.joernott.c0depaint.platform.fabric.C0dePaintFabric"
    ],
    "client": [
      "de.joernott.c0depaint.platform.fabric.C0dePaintFabricClient"
    ],
    "fabric-gametest": [
      "de.joernott.c0depaint.gametest.fabric.FabricGameTests"
    ]
  },
  "depends": {
    "fabricloader": ">=${loader}",
    "fabric-api": "*",
    "minecraft": "${minecraft}",
    "c0de": ">=${c0de_min} <${c0de_next}",
    "java": ">=21"
  }
}
